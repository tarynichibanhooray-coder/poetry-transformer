# Ignore local environment files and virtual environments
.env
.venv/
venv/

# Python cache and compiles
__pycache__/
*.py[cod]
*$py.class

# Project specific
poetry_transformer.db
output/

# SQLite sidecar files, recreated on every run because the app uses WAL mode
*.db-shm
*.db-wal
*.sqlite3

# Editor/IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Tests / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Packaging / build
build/
dist/
*.egg-info/
.eggs/

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Environment local override files
.env.local
.env.*.local

# Node
node_modules/

# Compiled extensions
*.so
